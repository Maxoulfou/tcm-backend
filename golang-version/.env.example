# HTTP runtime
PORT=8080
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# MySQL (or provide DB_DSN instead)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tcm
DB_PASSWORD=change-me
DB_NAME=tcm
# DB_DSN=tcm:change-me@tcp(127.0.0.1:3306)/tcm?parseTime=true&charset=utf8mb4&loc=America%2FToronto

# Generate with: openssl rand -hex 32
# Mandatory in production; never commit a real secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
