# HTTP
PORT=8080
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8080
STORAGE_DIR=./data/files

# Database: alternatively provide DB_DSN with parseTime=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tcm
DB_PASSWORD=change-me
DB_NAME=tcm
# DB_DSN=tcm:change-me@tcp(127.0.0.1:3306)/tcm?parseTime=true&charset=utf8mb4&loc=America%2FToronto

# Required for production; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
